{
  "mcpServers": {
    "vcollab": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--frozen",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}",
        "python",
        "${CLAUDE_PLUGIN_ROOT}/server.py"
      ],
      "env": {
        "UV_PROJECT_ENVIRONMENT": "${CLAUDE_PLUGIN_DATA}/venv",
        "VCOLLAB_DIR": "${user_config.vcollab_dir}",
        "VCOLLAB_ALLOWED_ROOTS": "${user_config.allowed_roots}"
      }
    }
  }
}
